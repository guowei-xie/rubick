# ---- 平台元数据库(拉比克自身)----
DATABASE_URL=mysql+pymysql://rubic:rubic@localhost:3306/rubic_meta

# ---- 安全 ----
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_MINUTES=720

# ---- 飞书(留空则启用 mock 登录)----
MOCK_AUTH=true
# 引导管理员:逗号分隔的飞书邮箱/open_id,这些人登录自动成为管理员(上线冷启动用)
# 例:BOOTSTRAP_ADMINS=zhangsan@company.com,lisi@company.com
BOOTSTRAP_ADMINS=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:5173/auth/callback

# ---- 结果对象存储(MinIO / S3 兼容)----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rubic-results
MINIO_SECURE=false
DOWNLOAD_URL_EXPIRE_SECONDS=3600
RESULT_RETENTION_DAYS=7

# ---- 取数资源治理 ----
QUERY_TIMEOUT_SECONDS=120
MAX_RESULT_ROWS=100000

# ---- 异步任务(Celery + Redis)----
REDIS_URL=redis://localhost:6379/0
ASYNC_QUERY=true
APP_BASE_URL=http://localhost:5173

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173
